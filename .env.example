DATABASE_URL=postgresql://user:password@host:5432/hitback
REDIS_URL=redis://default:password@host:6379
UPLOAD_DIR=/uploads
ANTHROPIC_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# Optional: only needed for campaigns without a user Meta connection (legacy/mock mode)
META_ACCESS_TOKEN=
META_PAGE_ID=
META_AD_ACCOUNT_ID=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
PEXELS_API_KEY=          # Free stock video backgrounds (pexels.com/api) — optional
VIDEO_VIBE_COUNT=       # Distinct visual backgrounds (default 5, max 10)
VIDEO_MATRIX=           # true = every vibe x every audio section (10 x 5 = 50 variants)
META_SINGLE_ADSET=      # false = one ad set per audience (default: consolidate into one)
