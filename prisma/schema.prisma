generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campaign {
  id              String         @id @default(uuid())
  artistName      String
  songTitle       String
  genre           String?
  mood            String?
  // Null for smart-link-only entries (kind = SMART_LINK) — they have artwork and
  // streaming links but no audio, no segments, no ads.
  audioUrl        String?
  coverArtUrl     String
  // CAMPAIGN = the full ad pipeline. SMART_LINK = just the /go landing page,
  // created standalone from /smartlinks without uploading audio.
  kind            String         @default("CAMPAIGN")
  autoLaunch      Boolean        @default(false)
  status          CampaignStatus @default(PENDING)
  metaCampaignId  String?
  visualConfig    Json?
  clipDefinitions Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  userId          String?
  spotifyUrl      String?
  spotifyPlaylistUrl String?
  // Other streaming destinations for the smart link. Any that are set render as
  // buttons on /go/{id}; the rest are hidden.
  appleMusicUrl   String?
  youtubeUrl      String?
  soundcloudUrl   String?
  soundsLike      String[]
  promoteType     String         @default("track")
  lastSyncAt      DateTime?
  dailyBudget     Float?
  // Paid "AI video" upsell. status: NONE | PROMPT | GENERATING | APPLIED | FAILED.
  // aiVideoOptions holds the generated clip URL(s); aiVideoChoiceUrl is the legacy
  // single pick. The AI clip loops as the background behind the normal overlay.
  aiVideoStatus   String    @default("NONE")
  aiVideoOptions  Json?
  aiVideoChoiceUrl String?
  // The artist's optional text prompt describing the AI background they want.
  aiVideoPrompt   String?
  // Deprecated (lyric-video feature shelved) — kept nullable to avoid a drop.
  lyrics          Json?

  jobs                CampaignJob[]
  segments            AudioSegment[]
  creatives           VideoCreative[]
  adCopies            AdCopy[]
  audiences           Audience[]
  user                User?          @relation(fields: [userId], references: [id])
  insights            AdInsight[]
  smartLinkClicks     SmartLinkClick[]
  optimisationLogs    OptimisationLog[]
  popularitySnapshots PopularitySnapshot[]
}

enum CampaignStatus {
  PENDING
  PROCESSING
  CONTENT_READY
  BUILDING
  READY
  LAUNCHING
  LIVE
  FAILED
  PAUSED
}

model CampaignJob {
  id         String    @id @default(uuid())
  campaignId String
  stage      JobStage
  status     JobStatus @default(PENDING)
  error      String?
  // Sub-step progress for long stages, e.g. { step: "Uploading videos",
  // current: 3, total: 10 }. Best-effort — purely for the UI.
  progress   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])
}

enum JobStage {
  SEGMENTATION
  VIDEO_GEN
  COPY_GEN
  AUDIENCE_GEN
  META_SETUP
  AI_VIDEO_GEN
  AI_VIDEO_PREVIEW
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model AudioSegment {
  id         String   @id @default(uuid())
  campaignId String
  fileUrl    String
  startSec   Float
  endSec     Float
  index      Int
  createdAt  DateTime @default(now())

  campaign  Campaign        @relation(fields: [campaignId], references: [id])
  creatives VideoCreative[]
}

model VideoCreative {
  id         String   @id @default(uuid())
  campaignId String
  segmentId  String
  fileUrl    String
  ctaText    String
  metaAdId   String?
  adStatus   String   @default("ACTIVE")
  createdAt  DateTime @default(now())

  campaign Campaign      @relation(fields: [campaignId], references: [id])
  segment  AudioSegment  @relation(fields: [segmentId], references: [id])
  adCopies AdCopy[]
}

model AdCopy {
  id          String   @id @default(uuid())
  campaignId  String
  creativeId  String?
  isSelected  Boolean  @default(false)
  headline    String
  primaryText String
  description String?
  createdAt   DateTime @default(now())

  campaign Campaign       @relation(fields: [campaignId], references: [id])
  creative VideoCreative? @relation(fields: [creativeId], references: [id])
}

model Audience {
  id                String       @id @default(uuid())
  campaignId        String
  name              String
  type              AudienceType
  interests         String[]
  lookalikeSeed     String?
  retargetingSource String?
  metaAdSetId       String?
  availabilityNote  String?
  dataStatus        String?
  createdAt         DateTime     @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
}

enum AudienceType {
  INTEREST
  RETARGETING
  LOOKALIKE
}

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  metaConnection      MetaConnection?
  campaigns           Campaign[]
  campaignCredits     Int     @default(0)
  stripeCustomerId    String?
  subscriptionId      String?
  subscriptionStatus  String?
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AdInsight {
  id             String   @id @default(uuid())
  campaignId     String
  metaAdSetId    String?
  metaAdId       String?
  date           DateTime
  spend          Float    @default(0)
  impressions    Int      @default(0)
  cpm            Float    @default(0)
  ctr            Float    @default(0)
  cpc            Float    @default(0)
  outboundClicks Int      @default(0)
  videoViews     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, metaAdSetId, metaAdId, date])
  @@index([campaignId])
}

// Daily snapshot of a track's Spotify popularity score (0-100). Append-only
// time series so we can chart popularity against ad spend — the metric that
// signals whether ads are actually moving Spotify's algorithm.
model PopularitySnapshot {
  id         String   @id @default(uuid())
  campaignId String
  date       DateTime
  popularity Int
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([campaignId])
}

model SmartLinkClick {
  id          String   @id @default(uuid())
  campaignId  String
  platform    String?
  country     String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  referrer    String?
  userAgent   String?
  createdAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model OptimisationLog {
  id            String   @id @default(uuid())
  campaignId    String
  metaAdSetId   String?
  metaAdId      String?
  action        String
  reason        String
  previousValue Float?
  newValue      Float?
  createdAt     DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// Tracks processed Stripe checkout sessions to prevent double-crediting
// when both the webhook and the verify fallback endpoint fire.
model StripeEvent {
  id        String   @id // Stripe checkout session ID (cs_...)
  userId    String
  createdAt DateTime @default(now())
}

model OtpToken {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model MetaConnection {
  id             String    @id @default(uuid())
  userId         String    @unique
  accessToken     String    @db.Text
  pageAccessToken String?   @db.Text
  tokenExpiresAt  DateTime?
  metaUserId     String
  adAccountId    String
  adAccountName  String?
  pageId              String
  pageName            String?
  availableAdAccounts Json?
  availablePages      Json?
  pixelId             String?
  pixelName      String?
  instagramUserId            String?
  instagramUsername          String?
  availableInstagramAccounts Json?
  // Reusable per-user audiences for lookalike targeting: a website custom
  // audience seeded on the pixel, and the lookalike built from it. Created once,
  // reused across all of this customer's campaigns.
  clickAudienceId            String?
  lookalikeAudienceId        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
